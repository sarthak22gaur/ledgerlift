# Directory holding both the SQLite database and YAML rule files.
# DB lives at $LEDGERLIFT_VAULT/ledgerlift.sqlite; YAMLs auto-sync after enrich.
# LEDGERLIFT_VAULT=~/.ledgerlift

# Advanced override: explicit DB path or Turso URL (disables YAML sync).
# LEDGERLIFT_DB=~/.ledgerlift/ledgerlift.sqlite
