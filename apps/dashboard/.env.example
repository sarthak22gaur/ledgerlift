# Directory holding both the SQLite database and YAML rule files.
# The pipeline writes ledgerlift.sqlite here; YAML files auto-sync on enrich.
# LEDGERLIFT_VAULT=/absolute/path/to/your/vault

# Advanced override: explicit DB path or Turso URL. Disables YAML sync.
# Takes precedence over LEDGERLIFT_VAULT when both are set.
# LEDGERLIFT_DB=/absolute/path/to/ledgerlift.sqlite
# LEDGERLIFT_DB=libsql://your-db.turso.io
# LIBSQL_AUTH_TOKEN=

# Access key for password gate (leave empty for open access in local dev)
# APP_ACCESS_KEY=

# App configuration
NEXT_PUBLIC_APP_NAME=LedgerLift
NEXT_PUBLIC_APP_ENV=development
